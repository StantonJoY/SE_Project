// V2 current project permission declaration; authorization and enforcement are distinct.
{
  "$schema": "https://opencode.ai/schemas/permissions.jsonc",
  "version": "2.0.0",
  "project": "SE_Project",
  "round": "V1+V2 effective baseline",
  "updated_at": "2026-10-31",
  "roles": {
    "plan": {
      "description": "产出执行计划清单（五要素），不写代码",
      "may_read": [
        "**"
      ],
      "may_write": [
        "docs/plans/**"
      ],
      "must_not_access": [
        "src/**",
        "test/**"
      ],
      "requires_human_approval_for": [
        "docs/plans/**"
      ]
    },
    "build": {
      "description": "按真实用户授权 V2 计划实现；不得修改独立 TEST 断言",
      "may_read": [
        "AGENTS.md",
        "architecture-blueprint.md",
        "Prompt.md",
        "config.yaml",
        "docs/req/**",
        "docs/architecture/**",
        "docs/code-governance/**",
        "docs/plans/**",
        "docs/execution-plan-template.md",
        "src/**",
        "eval/**",
        "data/**",
        ".github/**"
      ],
      "may_write": [
        "src/selector/**",
        "src/render/**",
        "src/audit/**",
        "src/app/**",
        "eval/**",
        "src/bidding/**",
        "data/bids-v2.json",
        "config-v2.yaml"
      ],
      "must_not_access": [
        "test/**"
      ],
      "may_run_tests_but_not_modify_them": true
    },
    "verify": {
      "description": "独立验证：跑门禁、审计一致性、出合规报告",
      "may_read": [
        "**"
      ],
      "may_write": [
        "docs/review-memo.md"
      ],
      "must_not_access": [],
      "forbidden_actions": [
        "modify_source_code",
        "write_adr",
        "modify_tests"
      ]
    },
    "tester": {
      "description": "编写并维护测试",
      "may_read": [
        "docs/req/requirements.yaml",
        "docs/code-governance/acceptance-coverage-map.yaml",
        "AGENTS.md",
        "docs/plans/**"
      ],
      "may_write": [
        "test/**"
      ],
      "must_not_access": [
        "src/**"
      ]
    },
    "human": {
      "description": "批准、决策、豁免；唯一可改 .opencode/rules.md 的角色",
      "may_read": [
        "**"
      ],
      "may_write": [
        "**"
      ],
      "sole_authority_over": [
        ".opencode/rules.md"
      ]
    },
    "supervisor": {
      "description": "真实用户委托的 AI proxy 技术评审；可读 source/tests 并协调修复；不能自我批准正式验收",
      "may_read": [
        "**"
      ],
      "may_write": [
        "docs/**",
        "AGENTS.md",
        "Prompt.md",
        "architecture-blueprint.md",
        "scripts/**",
        ".github/workflows/**",
        ".opencode/permissions.jsonc",
        "pyproject.toml",
        "README.md"
      ],
      "must_not_access": [
        ".opencode/rules.md"
      ],
      "forbidden_actions": [
        "forge_human_approval",
        "delete_or_skip_existing_tests",
        "publish_without_authorization"
      ]
    }
  },
  "path_rules": [
    {
      "id": "P-001",
      "match": "src/compliance/**",
      "guard": "safety_critical",
      "agent_access": "none",
      "requires": [
        "adr",
        "human_approval"
      ],
      "rationale": "FINAL AUTHORITY —— 合规裁决层，绕过它即绕过全部安全保证",
      "invariants": [
        "INV-ADS-001"
      ]
    },
    {
      "id": "P-002",
      "match": "src/ads/schema.py",
      "guard": "safety_critical",
      "agent_access": "none",
      "requires": [
        "adr",
        "human_approval"
      ],
      "rationale": "素材契约 —— 决定哪些字段可被信任",
      "invariants": [
        "INV-ADS-007",
        "INV-ADS-008"
      ]
    },
    {
      "id": "P-003",
      "match": "data/*.json",
      "guard": "safety_critical",
      "agent_access": "none",
      "requires": [
        "adr",
        "human_approval"
      ],
      "rationale": "违禁词表、场景规则、素材库 —— 安全判据的数据载体",
      "invariants": [
        "INV-ADS-007",
        "INV-ADS-008"
      ]
    },
    {
      "id": "P-004",
      "match": "docs/req/requirements.yaml",
      "guard": "safety_critical",
      "agent_access": "read",
      "requires": [
        "adr",
        "human_approval"
      ],
      "rationale": "需求单一来源 —— 改它即改验收标准",
      "invariants": [
        "INV-ADS-010"
      ]
    },
    {
      "id": "P-005",
      "match": "docs/architecture/invariants.md",
      "guard": "human_only",
      "agent_access": "read",
      "requires": [
        "human_approval"
      ],
      "rationale": "课程行 5183 明示 HUMAN ONLY；不变量是全部验证的基准",
      "invariants": [
        "INV-ADS-010"
      ]
    },
    {
      "id": "P-006",
      "match": "docs/architecture/adr-*.md",
      "guard": "human_only",
      "agent_access": "read",
      "requires": [
        "human_approval"
      ],
      "rationale": "ADR 是决策记录；agent 自批即违反课程 §11.3（No agent may self-approve）"
    },
    {
      "id": "P-007",
      "match": "src/selector/**",
      "guard": "adr_on_threshold_change",
      "agent_access": "write",
      "requires": [],
      "requires_on": {
        "condition": "改动阈值逻辑时",
        "requires": [
          "adr",
          "human_approval"
        ]
      },
      "rationale": "AI 建议层可写；但阈值语义是安全相关决策，不可静默改动",
      "invariants": [
        "INV-ADS-006"
      ]
    },
    {
      "id": "P-008",
      "match": "test/**",
      "guard": "protected_from_build",
      "agent_access": {
        "build": "none",
        "tester": "write",
        "verify": "read"
      },
      "requires": [],
      "rationale": "blindness invariant ①/②：BUILD 不得读测试；测试归属 TESTER",
      "invariants": [
        "INV-ADS-011"
      ]
    },
    {
      "id": "P-009",
      "match": "eval/**",
      "guard": "safety_critical",
      "agent_access": "read",
      "requires": [
        "adr",
        "human_approval"
      ],
      "rationale": "评估集是门禁 4 的判据来源；改判据以通过判据 = 掩盖而非失败（.agent/rules.md R2）",
      "invariants": [
        "INV-ADS-016"
      ],
      "closed_debt": "TD-025",
      "protected_by": "ADR-004（D1 验证平面）"
    },
    {
      "id": "P-013",
      "match": "scripts/check_*.py",
      "guard": "safety_critical",
      "agent_access": "read",
      "requires": [
        "adr",
        "human_approval"
      ],
      "rationale": "六道门禁的检查器 —— 改它们即让门禁恒通过",
      "protected_by": "ADR-004（D1 验证平面）"
    },
    {
      "id": "P-014",
      "match": "scripts/fitness_functions.py",
      "guard": "safety_critical",
      "agent_access": "read",
      "requires": [
        "adr",
        "human_approval"
      ],
      "rationale": "S1–S3 与 V1–V4 结构门的实现",
      "protected_by": "ADR-004（D1 验证平面）"
    },
    {
      "id": "P-015",
      "match": "scripts/mutation_check.py",
      "guard": "safety_critical",
      "agent_access": "read",
      "requires": [
        "adr",
        "human_approval"
      ],
      "rationale": "证明测试具备证伪能力的机制本身 —— 改它即可伪造『已覆盖』",
      "invariants": [
        "INV-ADS-011"
      ],
      "protected_by": "ADR-004（D1 验证平面）"
    },
    {
      "id": "P-016",
      "match": "docs/code-governance/acceptance-coverage-map.yaml",
      "guard": "safety_critical",
      "agent_access": "read",
      "requires": [
        "adr",
        "human_approval"
      ],
      "rationale": "覆盖声明 —— 把 test_backed 改 true 而无证据 = 伪造覆盖",
      "protected_by": "ADR-004（D1 验证平面）"
    },
    {
      "id": "P-010",
      "match": ".opencode/rules.md",
      "guard": "human_only",
      "agent_access": "none",
      "requires": [
        "human_approval"
      ],
      "rationale": "课程 D3 明示 human-only file —— 行为规则不可由被约束者自行修改"
    },
    {
      "id": "P-011",
      "match": ".github/workflows/**",
      "guard": "requires_approval",
      "agent_access": "read",
      "requires": [
        "human_approval"
      ],
      "rationale": "改 CI 即改门禁本身 —— 被约束者不得改判据"
    },
    {
      "id": "P-012",
      "match": "pyproject.toml",
      "guard": "requires_approval",
      "agent_access": "read",
      "requires": [
        "human_approval"
      ],
      "rationale": "依赖面变更影响供应链安全；由 scripts/check_dependencies.py 强制声明一致"
    }
  ],
  "deny": [
    {
      "id": "D-001",
      "action": "network_outside_explicit_http_relevance_provider",
      "rationale": "仅 V2 用户显式选择 http provider 时允许配置的 chat-completions endpoint；默认 fixed、离线 CI 不联网",
      "enforced_by": [
        "HTTP provider injection boundary + offline tests; network firewall not claimed"
      ]
    },
    {
      "id": "D-002",
      "action": "read_undeclared_environment_inputs",
      "rationale": "V2 CLI 仅通过配置的 api_key_env 读取凭证，默认名称 V2_LLM_API_KEY；配置只存名称，不存值",
      "enforced_by": [
        "CLI boundary + source review; env access not sandboxed by this file"
      ]
    },
    {
      "id": "D-003",
      "action": "delete_or_skip_existing_tests",
      "rationale": "回归门的基础 —— 删除测试即降低标准",
      "enforced_by": [
        "fitness_functions.py 的 V4 检查（REQUIRED_TEST_MODULES）"
      ],
      "invariants": [
        "INV-ADS-011"
      ]
    },
    {
      "id": "D-004",
      "action": "modify_architecture_outside_authorized_plan",
      "rationale": "V2 授权同目录追加架构；安全语义变化须 ADR，正式 human acceptance 独立保留",
      "enforced_by": [
        "人工审查"
      ],
      "invariants": [
        "INV-ADS-010"
      ]
    },
    {
      "id": "D-005",
      "action": "invoke_write_tools_before_plan_approval",
      "rationale": "课程行 3830 MANDATE：执行计划清单获批前，严格禁止输出源代码、修改文件或调用执行类工具",
      "enforced_by": [
        "流程纪律 + docs/ai-use-log.yaml 的角色记录"
      ],
      "source": "docs/plans/P4-selector.md §7 的批准记录"
    },
    {
      "id": "D-006",
      "action": "self_approve",
      "rationale": "课程 §11.3 No agent may self-approve —— 批准者必须是具名人类",
      "enforced_by": [
        "docs/test-approvals.yaml 的 approved_by 校验（占位符即视为不可信）"
      ],
      "source": "scripts/check_test_approval.py"
    }
  ],
  "enforcement": {
    "hooks": [
      {
        "id": "H-001",
        "event": "pre_commit",
        "script": "scripts/check_safety_paths.py",
        "purpose": "拦截 safety-critical 路径的无 ADR 变更",
        "status": "installed_in_ci",
        "installer": "scripts/install_hooks.py",
        "local_pre_commit_installed": false,
        "gap_debt": "TD-026",
        "note": "本地 hook 的**安装器已就位**（含 --check / --uninstall，且拒绝覆盖他人 hook），但 agent 会话的沙箱不允许写 .git/hooks/ —— 须由人类在自己的环境执行一次安装。当前拦截仍只在 CI 阶段生效。"
      },
      {
        "id": "H-002",
        "event": "ci",
        "script": "scripts/check_test_approval.py",
        "purpose": "门禁 1：测试须在实现开始前获批",
        "status": "installed"
      },
      {
        "id": "H-003",
        "event": "ci",
        "script": "scripts/check_ai_use_log.py",
        "purpose": "门禁 6：改代码或 prompt 未更新 AI-use 日志即阻塞",
        "status": "installed"
      },
      {
        "id": "H-004",
        "event": "ci",
        "script": "scripts/check_semantic_eval.py",
        "purpose": "门禁 4：prompt/model 变更须 replay 固定评估集过阈值",
        "status": "installed"
      }
    ],
    "fitness_functions": {
      "script": "scripts/fitness_functions.py",
      "checks": [
        "S1 一个架构元素恰好一个模块",
        "S2 扩展永不删除 + 权威边界（selector ↮ compliance 双向禁止依赖）",
        "S3 模块/函数 docstring 引用其实现的 ADR 与不变量",
        "V1 每条 fit criterion ≥1 测试",
        "V2 每条不变量 ≥1 个会失败的反例测试",
        "V3 每个测试引用其验证的 REQ/INV",
        "V4 跨轮次无回归（既有测试模块不得消失）"
      ],
      "status": "installed"
    },
    "branch_protection": {
      "document": "docs/branch-protection.md",
      "required_checks": 6,
      "status": "documented_not_yet_enabled",
      "note": "需仓库管理员在 GitHub 后台启用 —— agent 无法执行"
    }
  },
  "enforcement_reality": {
    "mechanically_enforced": [
      "P-001~P-004 + P-009 + P-013~P-016：safety-critical 路径的变更须带 ADR 引用（check_safety_paths.py，清单来自 ADR-002 D4 + ADR-004 D1）",
      "P-008：测试模块不得删除（fitness V4）",
      "D-003：既有测试不得消失（fitness V4）",
      "D-006：占位符批准者不被采信（check_test_approval.py）",
      "V2 fitness resolves actual enforcement symbols and nontrivial evidence tests",
      "Gate 4 replays both V1/V2 on Python prompts, auction/pipeline/config/bid changes",
      "Gate 1 rejects code-only approval bypass and AI proxy approvals"
    ],
    "not_mechanically_enforceable": [
      "T1/T2 读工具的角色限制 —— 读取无副作用，CI 不可观测",
      "D-002 环境变量读取 —— 需人工审查",
      "D-004 架构工件改动 —— 仅人工审查可拦",
      "D-005 计划获批前的工具调用 —— 流程纪律，非技术拦截",
      "P-007 的『改动阈值逻辑』条件 —— 需人工判断何为阈值语义变更",
      "Remote branch protection and live provider quality are unverified; declarative permissions are not a runtime network sandbox"
    ],
    "mitigations": [
      "docs/ai-use-log.yaml 逐会话记录角色与产出（门禁 6 强制其存在）",
      "执行计划清单（docs/plans/）使 BUILD 的产出可追溯到已批准的规格",
      "CODEOWNERS + 分支保护提供人工评审这一最后防线"
    ],
    "residual_risk": "读工具的滥用（如 BUILD 偷看测试）在技术上无法拦截；本项目的应对是『使产出可追溯』而非『使违规不可能』。这是可接受的残余风险，但必须显式声明而非默认不存在。"
  },
  "v2_authorization": {
    "source": "docs/plans/V2-execution.md",
    "kickoff_at": "2026-10-30T12:10:56.447Z",
    "work_authorized": true,
    "formal_acceptance": "pending_human_acceptance",
    "proxy_review_is_human_approval": false,
    "protected_paths_source": "ADR-002 + ADR-004 + ADR-005 marked tables",
    "precedence": "original course PDF and actual user instructions; V1 historical conventions do not add course constraints"
  }
}
