{
  "_meta": {
    "purpose": "V1 场景化广告推荐引擎的固定评估集（ADR-003 / ASR-ADS-15 / REQ-ADS-NFR-QA-001）",
    "authority": "只读验证资产，不参与运行时决策（ADR-003 D1/D7）",
    "replay": "python eval/eval_runner.py",
    "label_semantics": {
      "MUST_PASS": "期望产出广告；**计入**通过率分母（ADR-003 D3）",
      "MUST_FAIL": "期望降级为 no_ad；**不计入**分母，单独统计（ADR-003 D3）",
      "MUST_FAIL_ON_REPLAY": "已知且被接受的失败；不计入分母但必须列出并附理由（ADR-003 D3）"
    },
    "reason_code_checked": "expect_reason 在 MUST_FAIL 用例中会被严格比对 —— 防止「降级了但不是因为预期原因」被误判为通过",
    "mock_capabilities": {
      "confidence": "固定置信度（默认 0.85）；用于低置信度路径",
      "raw_override": "原样返回该文本；用于构造畸形输出",
      "fail_with": "抛出 LLMUnavailable；用于测试不可用路径"
    },
    "author_note": "由 agent 自造并逐条实测确认（OQ-005 resolution）；人类审查后可增改。每条 basis 说明它为何存在。"
  },

